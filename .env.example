# Copy to .env and fill in. .env is gitignored: it holds real credentials.
#
#   set -a; . ./.env; set +a; ./bin/opg3d-backend

# --- Network ---------------------------------------------------------------
OPG3D_ADDR=:8080
OPG3D_SERVER_NAME=open-pixel-gun-3d-backend
OPG3D_DISCOVERY_PORT=47318

# --- Storage and logs ------------------------------------------------------
OPG3D_DATA_DIR=data
OPG3D_LOG_DIR=logs
# Static remote config served under /pixelgun3d-config/.
OPG3D_CONTENT_DIR=content
OPG3D_TRACE_BODIES=true
OPG3D_MAX_BODY_LOG=8192

# --- Administration --------------------------------------------------------
# Leave empty to keep /api/v1/admin/* closed. Generate: openssl rand -hex 32
OPG3D_ADMIN_TOKEN=
OPG3D_MAINTENANCE=false

# --- Photon credentials ----------------------------------------------------
# The key that seals AppIDs for the client: 64 hex chars, or any passphrase.
# Generate: openssl rand -hex 32
OPG3D_APPID_KEY=
OPG3D_PHOTON_APPID_PUN=
# Empty PUN falls back to the Realtime AppID: PUN clients connect to a Realtime app.
OPG3D_PHOTON_APPID_REALTIME=
OPG3D_PHOTON_APPID_CHAT=
OPG3D_PHOTON_APPID_VOICE=
OPG3D_PHOTON_REGION=eu

# --- Client updates --------------------------------------------------------
OPG3D_UPDATE_VERSION=
OPG3D_UPDATE_APK_URL=
OPG3D_UPDATE_SHA256=
OPG3D_UPDATE_NOTES_URL=
OPG3D_UPDATE_MANDATORY=false
