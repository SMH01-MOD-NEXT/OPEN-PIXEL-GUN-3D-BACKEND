# Copy to .env and fill in. .env is gitignored: it holds real credentials.
#
#   set -a; . ./.env; set +a; ./bin/opg3d-backend

# --- Network ---------------------------------------------------------------
OPG3D_ADDR=:8080
OPG3D_SERVER_NAME=open-pixel-gun-3d-backend
OPG3D_DISCOVERY_PORT=47318

# Docker Compose host-side port mappings. The native binary ignores these.
OPG3D_HTTP_PORT=8080
OPG3D_DISCOVERY_HOST_PORT=47318

# --- Storage and logs ------------------------------------------------------
OPG3D_DATA_DIR=data
OPG3D_LOG_DIR=logs
# Static remote config served under /pixelgun3d-config/.
OPG3D_CONTENT_DIR=content
OPG3D_TRACE_BODIES=true
OPG3D_MAX_BODY_LOG=8192

# --- Administration --------------------------------------------------------
# Leave empty to keep /api/v1/admin/* closed. Generate: openssl rand -hex 32
OPG3D_ADMIN_TOKEN=
OPG3D_MAINTENANCE=false

# --- Diagnostics -----------------------------------------------------------
# SECURITY-SENSITIVE. Keep false on anything reachable from outside a lab.
# Derives the account session token from the device id instead of minting 32
# random bytes, so the same device gets the same token on every login. Used to
# find out whether the /sio payload key is derived from the session token: with
# this on, an attachment that stays byte-identical across two runs proves it is.
OPG3D_STABLE_SESSIONS=false

# --- Photon credentials ----------------------------------------------------
# The key that seals AppIDs for the client: 64 hex chars, or any passphrase.
# Generate: openssl rand -hex 32
OPG3D_APPID_KEY=
OPG3D_PHOTON_APPID_PUN=
# Empty PUN falls back to the Realtime AppID: PUN clients connect to a Realtime app.
OPG3D_PHOTON_APPID_REALTIME=
OPG3D_PHOTON_APPID_CHAT=
OPG3D_PHOTON_APPID_VOICE=
OPG3D_PHOTON_REGION=eu

# --- Client updates --------------------------------------------------------
OPG3D_UPDATE_VERSION=
OPG3D_UPDATE_APK_URL=
OPG3D_UPDATE_SHA256=
OPG3D_UPDATE_NOTES_URL=
OPG3D_UPDATE_MANDATORY=false

# Optional signed native frontend publishing directory and display country.
# OPG3D_FRONTEND_DIR=/absolute/path/to/content/frontend
# OPG3D_SERVER_COUNTRY=RU

# Website login via the personal game mailbox. Exact HTTPS origin, no trailing
# slash. Empty disables web login; incompatible with OPG3D_STABLE_SESSIONS.
# See docs/WEB_AUTH.md for TLS, API, cookie and game-transport limitations.
OPG3D_WEB_AUTH_ORIGIN=

# HUB security state encryption. Generate once: openssl rand -hex 32.
# Back up this stable key together with data/hub-security.enc; never commit it.
# Existing encrypted state + missing/wrong key DISABLES web authentication.
OPG3D_HUB_SECURITY_KEY=
# Optional owner-provided HTTPS download URL (e.g. OneDrive); empty disables CTA.
OPG3D_HUB_DOWNLOAD_URL=
